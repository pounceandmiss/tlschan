# www.test --
#
#	Real servers; run with TLS_NETWORK=1.

source [file join [file dirname [info script]] helpers.tcl]
package require http

proc fetch {url args} {
    set tok [http::geturl $url -timeout 15000 {*}$args]
    try {
	list [http::status $tok] [http::ncode $tok]
    } finally {
	http::cleanup $tok
    }
}

foreach {n host} {1 www.google.com 2 github.com 3 www.tcl-lang.org
	4 www.cloudflare.com} {
    test www-1.$n "https://$host with the system store" -constraints network \
	    -setup {
	http::register https 443 ${T}::socket
    } -body {
	lindex [fetch https://$host/] 0
    } -cleanup {
	http::unregister https
    } -result ok
}

test www-1.5 {nonblocking http::geturl with -command} -constraints network \
	-setup {
    http::register https 443 ${T}::socket
} -body {
    http::geturl https://www.google.com/ -timeout 15000 \
	-command {apply {{tok} {
	    set ::www [http::status $tok]
	    http::cleanup $tok
	}}}
    await ::www 20000
} -cleanup {
    http::unregister https
    unset -nocomplain ::www
} -result ok

# badssl.com drops some handshakes from OpenSSL 3.5 and later, silently or
# not (the openssl command line's too), so it gets a deadline and retries.
proc badssl {host args} {
    global T
    foreach try {1 2 3} {
	set c [${T}::socket {*}$args $host.badssl.com 443]
	fconfigure $c -blocking 0
	fileevent $c readable {set ::www ready}
	set state ready
	while {$state eq "ready"} {
	    if {[catch {${T}::handshake $c} done]} {
		set state $done
	    } elseif {$done} {
		fileevent $c readable {}
		fconfigure $c -blocking 1
		return $c
	    } else {
		unset -nocomplain ::www
		set state [await ::www 10000]
	    }
	}
	close $c
	if {$state ne "timeout" && ![string match *closed* $state]} {
	    return -code error $state
	}
    }
    error "no handshake with $host.badssl.com"
}

foreach {n host} {1 expired 2 wrong.host 3 self-signed 4 untrusted-root} {
    test www-2.$n "$host.badssl.com is refused" -constraints network -body {
	badssl $host
    } -cleanup {
	unset -nocomplain ::www
    } -returnCodes error -match glob -result {*handshake failed: *}
}

test www-2.5 {badssl with -require 0} -constraints network -body {
    set c [badssl expired -require 0]
    puts -nonewline $c "HEAD / HTTP/1.0\r\nHost: expired.badssl.com\r\n\r\n"
    flush $c
    gets $c
} -cleanup {
    catch {close $c}
    unset -nocomplain ::www
} -match glob -result {HTTP/1.1 *}

cleanupTests
